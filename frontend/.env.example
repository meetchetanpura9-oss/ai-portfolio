# Required server-side mail configuration
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=replace-with-app-password
ADMIN_EMAIL=admin@example.com

# Optional site label
SITE_NAME=Example Portfolio

# Optional public frontend settings
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_CONTACT_GITHUB=https://github.com/example
NEXT_PUBLIC_CONTACT_LINKEDIN=https://www.linkedin.com/in/example
NEXT_PUBLIC_CONTACT_LOCATION=Example City
