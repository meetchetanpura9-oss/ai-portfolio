# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_portfolio
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# CORS (comma-separated frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://meetchetanpura.in,https://www.meetchetanpura.in

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Admin notifications (your email & phone)
ADMIN_EMAIL=meetchetanpura9@gmail.com
ADMIN_NAME=Meet
SITE_NAME=Chetanpura Meet — AI Portfolio

# SMTP (Gmail app password — see NOTIFICATIONS_SETUP.md)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=meetchetanpura9@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=meetchetanpura9@gmail.com
MAIL_FROM_NAME=AI Portfolio
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Twilio (SMS only) — India number in E.164: +919998471715
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1xxxxxxxxxx
ADMIN_PHONE_SMS=+919998471715

# Protect list/export endpoints
ADMIN_API_KEY=change-this-to-a-secret-key

# Environment: production | development | test. Empty = auto (production on Render,
# which sets RENDER=true; development elsewhere).
APP_ENV=development
# Signing secrets — two DIFFERENT long random values, independent of DATABASE_URL:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production: the app refuses to start if either is missing, if they are
# equal, or if one is part of DATABASE_URL. Development uses labelled dev-only values.
JWT_SECRET=
# Signs unsubscribe links. Set once and never change it, or old unsubscribe links stop working.
NEWSLETTER_CONFIRMATION_SECRET=

# Resend (email + newsletter). Server-side only — never put these in the frontend.
RESEND_API_KEY=
RESEND_FROM=hello@meetchetanpura.in
NEWSLETTER_FROM_NAME=Meet Chetanpura
# Resend dashboard → Audience → Segments → create "Newsletter" → copy its ID
RESEND_NEWSLETTER_SEGMENT_ID=
# Resend dashboard → Webhooks → endpoint https://<api>/webhooks/resend → signing secret (whsec_...)
RESEND_WEBHOOK_SECRET=

# Public URLs used in email links
APP_BASE_URL=https://www.meetchetanpura.in
API_BASE_URL=https://ai-portfolio-8wpd.onrender.com
NEWSLETTER_DOUBLE_OPT_IN=true
NEWSLETTER_CONFIRMATION_HOURS=48
