# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_portfolio
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# CORS (comma-separated frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Admin notifications (your email & phone)
ADMIN_EMAIL=meetchetanpura9@gmail.com
ADMIN_NAME=Meet
SITE_NAME=Chetanpura Meet — AI Portfolio

# SMTP (Gmail app password — see NOTIFICATIONS_SETUP.md)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=meetchetanpura9@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=meetchetanpura9@gmail.com
MAIL_FROM_NAME=AI Portfolio
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Twilio (SMS + WhatsApp) — India number in E.164: +919998471715
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_PHONE_SMS=+919998471715
